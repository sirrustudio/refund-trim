{
  "name": "refund-trim",
  "version": "0.0.0",
  "private": true,
  "description": "A read-only copy of the code behind Trim, a page in the Refund iPhone app.",
  "license": "MIT",
  "scripts": {
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
